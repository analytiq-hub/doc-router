ENV="test"

# Product name in the UI, browser tab, API docs, and emails (default: Smart Document Router)
#APP_NAME="Smart Document Router"
# Optional path to a .ico file (relative to repo root) for the browser tab icon
#APP_FAVICON="branding/favicon.ico"

MONGODB_URI="mongodb://127.0.0.1:27017/?directConnection=true"
#MONGODB_URI="mongodb+srv://andrei:GpAxrVLPH7nrCZ9S@cluster0.xrzxa.mongodb.net/"

# FastAPI backend root path
FASTAPI_ROOT_PATH="/"
# Symmetric key: session JWT (FastAPI) and at-rest encryption of stored credentials
APP_SECRET="abcabc"

# Create an admin user
ADMIN_EMAIL="admin@docrouter.ai"
ADMIN_PASSWORD="admin"

# Set up API credentials for various services. 
# These can also be set up later in the GUI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Server-side encryption header sent on S3 uploads (e.g. Textract input files).
# Leave empty for none. Set to "aws:kms" (or "AES256") if your AWS org enforces
# a resource control policy that denies s3:PutObject without an
# x-amz-server-side-encryption header.
AWS_S3_SSE=

FLOW_CODE_EXTERNAL_ALLOW=fitz

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=


# Email verification
SES_FROM_EMAIL="andrei+noreply@analytiqhub.com"

# Browser API prefix for the Vite SPA (dev: use same-origin proxy — see vite.config /fastapi)
# Production Docker bake: /fastapi via PUBLIC_API_URL build arg
PUBLIC_API_URL=http://127.0.0.1:8000
VITE_FASTAPI_FRONTEND_URL=/fastapi

# Track B PDF viewer (pdfjs-dist PDFViewer). Legacy react-pdf when unset.
#VITE_PDF_VIEWER_V2=1

# FastAPI backend (Vite dev proxy target — vite.config `VITE_BACKEND_URL` or this in tooling)
FASTAPI_BACKEND_URL=http://127.0.0.1:8000

# Public browser URL of the SPA (legacy name; used for OAuth return_to and CORS)
# When doing local development, can be http://127.0.0.1:3000
# Vite dev (5173) sends app_origin on OAuth start; also register redirect URIs:
#   http://localhost:5173/fastapi/v0/account/auth/google/callback
#   http://localhost:5173/fastapi/v0/account/auth/github/callback
# When deploying, this should be the production URL https://doc-router.analytiq.com
NEXTAUTH_URL=http://127.0.0.1:3000
# Optional extra browser origins for CORS (comma-separated)
# CORS_ORIGINS_EXTRA=http://localhost:5173
# Github OAuth
AUTH_GITHUB_ID=...
AUTH_GITHUB_SECRET=...

# Google OAuth
AUTH_GOOGLE_ID=...
AUTH_GOOGLE_SECRET=...

#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_PUBLISHABLE_KEY=pk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
