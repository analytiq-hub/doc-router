{
  "name": "doc-router-ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Puppeteer + Jest UI tests for Doc Router",
  "scripts": {
    "test:ui": "jest --config jest.config.js",
    "test:ui:watch": "jest --config jest.config.js --watch",
    "test:ui:coverage": "jest --config jest.config.js --coverage",
    "test:ui:debug": "HEADLESS=false SLOW_MO=100 jest --config jest.config.js --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "jest": "^30.0.5",
    "jest-environment-node": "^30.0.5",
    "puppeteer": "^25.13.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@babel/core": ">=7.29.6",
    "brace-expansion": ">=2.1.7",
    "browserslist": ">=4.28.7",
    "glob": ">=10.5.0",
    "js-yaml": "^4.1.0",
    "minimatch": ">=9.0.7",
    "picomatch": ">=4.0.4",
    "ws": ">=8.21.0"
  }
}
